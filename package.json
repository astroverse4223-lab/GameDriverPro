{
  "name": "gamedriver-pro",
  "productName": "GameDriver Pro",
  "version": "0.1.0",
  "description": "Your PC. Your Games. Always Ready. — gaming driver manager, hardware monitor and optimization center.",
  "private": true,
  "main": "dist/main/index.cjs",
  "author": "GameDriver Pro",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "npm run build && electron-builder --win --publish never",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "build": {
    "appId": "com.gamedriverpro.app",
    "productName": "GameDriver Pro",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "resources/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
